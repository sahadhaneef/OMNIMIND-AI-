# Local development only. Copy to .env and replace both password placeholders.
POSTGRES_USER=omnimind
POSTGRES_PASSWORD=replace-with-local-password
POSTGRES_DB=omnimind
DATABASE_URL=postgresql+psycopg://omnimind:replace-with-local-password@localhost:5432/omnimind
ENVIRONMENT=development
COOKIE_SECURE=false
ALLOWED_ORIGINS=["http://localhost:5173"]
ALLOWED_HOSTS=["localhost","127.0.0.1"]
SESSION_HOURS=8
LOGIN_LIMIT=10
LOGIN_WINDOW_SECONDS=900
